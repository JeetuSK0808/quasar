include LICENSE
include README.md
include CHANGELOG.md
include SECURITY.md
include CONTRIBUTING.md
recursive-include quasar/rules *.yar *.yara

# never ship private drafts, samples, models, or build/eval artifacts
prune paper
prune samples
prune models
prune eval
prune scripts
prune tests
prune dist
global-exclude *.pyc
global-exclude .DS_Store
global-exclude __pycache__
